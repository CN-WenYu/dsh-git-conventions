{
  "name": "dsh-git-conventions",
  "version": "0.1.0",
  "description": "Enforce configurable git commit / push / PR conventions for DeepSeek Harness agents",
  "author": "雨果 (cn_wenyu)",
  "homepage": "https://github.com/CN-WenYu/dsh-git-conventions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CN-WenYu/dsh-git-conventions.git"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "git",
    "conventional-commits",
    "commit-lint",
    "guard"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test 'test/*.test.mjs'",
    "check": "node --check lib/index.js && node --check lib/client.js"
  }
}
